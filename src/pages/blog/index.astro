---
import Layout from '../../layouts/Layout.astro';
import { getPortfolioData, getTagColor } from '../../utils/data.js';
import { getPublishedPosts, formatDate } from '../../utils/blog.js';
import '../../styles/blog.css';

const profile = getPortfolioData().profile || {};
const posts = await getPublishedPosts();
---

<Layout
    title={`Blog | ${profile.name}`}
    description="開発や日々の気づきについてのブログ。"
>
    <header class="page-header" role="banner">
        <div class="page-header-inner">
            <a href="/" class="back-link" aria-label="ポートフォリオに戻る">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
                戻る
            </a>
            <span class="page-header-sep" aria-hidden="true">/</span>
            <span class="page-header-title">Blog</span>
        </div>
    </header>

    <main id="main-content">
        <section class="blog-hero" aria-label="ページ概要">
            <div class="container">
                <h1 class="blog-title">Blog</h1>
            </div>
        </section>

        <div class="container">
            {
                posts.length === 0 ? (
                    <p class="blog-empty">記事はまだありません。</p>
                ) : (
                    <ul class="post-list">
                        {posts.map((post) => (
                            <li class="post-item">
                                <a
                                    href={`/blog/${post.id}/`}
                                    class="post-link"
                                >
                                    <time
                                        class="post-date"
                                        datetime={post.data.date.toISOString()}
                                    >
                                        {formatDate(post.data.date)}
                                    </time>
                                    <h2 class="post-title">
                                        {post.data.title}
                                    </h2>
                                    {post.data.description && (
                                        <p class="post-desc">
                                            {post.data.description}
                                        </p>
                                    )}
                                    {post.data.tags.length > 0 && (
                                        <div class="post-tags">
                                            {post.data.tags.map((tag) => (
                                                <span
                                                    class="tag"
                                                    data-color={getTagColor(
                                                        tag
                                                    )}
                                                >
                                                    {tag}
                                                </span>
                                            ))}
                                        </div>
                                    )}
                                </a>
                            </li>
                        ))}
                    </ul>
                )
            }
        </div>
    </main>

    <footer class="footer">
        <div class="container footer-inner">
            <p class="footer-copy">
                {`© ${new Date().getFullYear()} ${profile.name}`}
            </p>
        </div>
    </footer>

    <script>
        import { ACTIVE_THEME, applyTheme } from '../../scripts/common.js';
        applyTheme(ACTIVE_THEME);
    </script>
</Layout>
