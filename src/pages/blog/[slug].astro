---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getPortfolioData, getTagColor } from '../../utils/data.js';
import { getPublishedPosts, formatDate } from '../../utils/blog.js';
import '../../styles/blog.css';

export async function getStaticPaths() {
    const posts = await getPublishedPosts();
    return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const profile = getPortfolioData().profile || {};
---

<Layout
    title={`${post.data.title} | ${profile.name}`}
    description={post.data.description || undefined}
>
    <header class="page-header" role="banner">
        <div class="page-header-inner">
            <a href="/blog/" class="back-link" aria-label="記事一覧に戻る">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
                記事一覧
            </a>
            <span class="page-header-sep" aria-hidden="true">/</span>
            <span class="page-header-title">Blog</span>
        </div>
    </header>

    <main id="main-content">
        <article class="container article">
            <header class="article-header">
                <time
                    class="post-date"
                    datetime={post.data.date.toISOString()}
                >
                    {formatDate(post.data.date)}
                </time>
                <h1 class="article-title">{post.data.title}</h1>
                {
                    post.data.tags.length > 0 && (
                        <div class="post-tags">
                            {post.data.tags.map((tag) => (
                                <span class="tag" data-color={getTagColor(tag)}>
                                    {tag}
                                </span>
                            ))}
                        </div>
                    )
                }
            </header>
            <div class="prose">
                <Content />
            </div>
        </article>
    </main>

    <footer class="footer">
        <div class="container footer-inner">
            <p class="footer-copy">
                {`© ${new Date().getFullYear()} ${profile.name}`}
            </p>
        </div>
    </footer>

    <script>
        import { ACTIVE_THEME, applyTheme } from '../../scripts/common.js';
        applyTheme(ACTIVE_THEME);
    </script>
</Layout>
