---
import Layout from '../layouts/Layout.astro';
import {
    getPortfolioData,
    getTagColor,
    ICONS,
    getTextBlocks,
} from '../utils/data.js';
import '../styles/index.css';
import * as simpleIcons from 'simple-icons';
import logosSet from '@iconify-json/logos/icons.json';
import skillIconsSet from '@iconify-json/skill-icons/icons.json';

const data = getPortfolioData();
const profile = data.profile || {};
const organizations = data.organizations || [];
const works = data.works || [];
const skills = data.skills || [];
const activities = data.activities || [];

const tagCounts = {};
works.forEach((w) => {
    (w.tags ?? []).forEach((tag) => {
        getTagColor(tag);
        tagCounts[tag] = (tagCounts[tag] ?? 0) + 1;
    });
});
const allTags = Object.keys(tagCounts);

// 技能: レベルごとの軌道(内側ほど習熟)と、レベルを持たない領域(Domains)に分ける
const SKILL_LEVELS = ['メイン', 'サブ', '勉強中'];
// 輪ごとの開始角(度)。輪の間隔がチップの直径より広いので、重なりは起きない
const RING_PHASES = [20, -75, -10];
// アイコンは Simple Icons (CC0)。商標は各社に帰属する
const getSkillIcon = (slug) => {
    const icon =
        simpleIcons[`si${slug.charAt(0).toUpperCase()}${slug.slice(1)}`];
    return icon ? { path: icon.path, hex: icon.hex } : null;
};
// 多色のロゴは Iconify のセットから使う (logos: CC0 / skill-icons: MIT)
const ICON_SETS = { logos: logosSet, 'skill-icons': skillIconsSet };
const getSkillLogo = (key) => {
    const [setName, name] = key.split(':');
    const set = ICON_SETS[setName];
    const icon = set?.icons[name];
    if (!icon) return null;
    return {
        body: icon.body,
        viewBox: `0 0 ${icon.width ?? set.width ?? 16} ${icon.height ?? set.height ?? 16}`,
    };
};
const allSkillItems = skills.flatMap((g) =>
    (g.items ?? []).map((item) => ({ ...item, category: g.category }))
);
const skillRings = SKILL_LEVELS.map((level, ri) => {
    const items = allSkillItems.filter((s) => s.level === level);
    return {
        level,
        items: items.map((s, i) => ({
            ...s,
            angle: Math.round((RING_PHASES[ri] + (360 / items.length) * i) * 10) / 10,
            iconData: s.icon ? getSkillIcon(s.icon) : null,
            logoData: s.logo ? getSkillLogo(s.logo) : null,
            mono: s.monogram ?? s.name.slice(0, 2),
        })),
    };
}).filter((ring) => ring.items.length > 0);
const skillDomains = allSkillItems.filter((s) => !s.level);

const SHOW_THUMBNAILS = true;

// 制作物の詳細モーダル用データ (detail を持つ作品のみ。キーは works の添字)
const worksDetail = {};
works.forEach((w, i) => {
    if (!w.detail?.text) return;
    worksDetail[i] = {
        title: w.title,
        text: w.detail.text,
        images: (w.detail.images?.length
            ? w.detail.images
            : w.thumbnail
              ? [w.thumbnail]
              : []
        ).map((src) => `/${src}`),
        tags: (w.tags ?? []).map((name) => ({
            name,
            color: getTagColor(name),
        })),
        url: w.url ?? '',
        github: w.github ?? '',
    };
});
const textBlocks = Array.isArray(profile.about)
    ? getTextBlocks(profile.about)
    : profile.about;
---

<Layout title={`Portfolio | ${profile.name}`}>
    <main id="main-content">
        <section id="hero" class="section hero" aria-label="プロフィール">
            <div class="container hero-content">
                <h1 class="hero-name" id="hero-name" elementtiming="LCP">
                    {profile.name}
                </h1>
                <p class="hero-tagline" id="hero-tagline">{profile.tagline}</p>
                <div class="hero-links" id="hero-links" role="list">
                    {
                        profile.github && (
                            <a
                                id="btn-github"
                                href={profile.github}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="btn-social btn-github"
                                role="listitem"
                                aria-label="GitHub"
                            >
                                <Fragment set:html={ICONS.github} /> GitHub
                            </a>
                        )
                    }
                    {
                        profile.x && (
                            <a
                                id="btn-x"
                                href={profile.x}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="btn-social btn-x"
                                role="listitem"
                                aria-label="X"
                            >
                                <Fragment set:html={ICONS.x} /> X
                            </a>
                        )
                    }
                </div>
            </div>
            <div class="hero-scroll-hint" aria-hidden="true">
                <span class="scroll-line"></span>
            </div>
        </section>

        <section id="intro" class="section" aria-label="人物">
            <div class="container">
                <div class="section-header fade-up">
                    <h2 class="section-title">人物</h2>
                </div>
                <p id="intro-text" class="intro-text fade-up">
                    {
                        Array.isArray(textBlocks) ? (
                            textBlocks.map((b) => (
                                <>
                                    {b.literalSpaceBefore ? ' ' : ''}
                                    {b.visualSpaceBefore ? (
                                        <span
                                            class="visual-space"
                                            aria-hidden="true"
                                        >
                                            {' '}
                                        </span>
                                    ) : (
                                        ''
                                    )}
                                    <span class={b.className}>{b.text}</span>
                                </>
                            ))
                        ) : (
                            <Fragment set:html={textBlocks} />
                        )
                    }
                </p>
            </div>
        </section>

        <section id="organizations" class="section" aria-label="所属組織">
            <div class="container">
                <div class="section-header fade-up">
                    <h2 class="section-title">所属</h2>
                </div>
                <div class="org-grid" id="org-grid">
                    {
                        organizations.map((org, i) => {
                            const hasModal =
                                !!org.projects && org.projects.length > 0;
                            const modalAttr = hasModal
                                ? { 'data-org-index': i }
                                : {};
                            const modalClass = hasModal ? 'org-card-modal' : '';
                            const cardRole = hasModal
                                ? { role: 'button', tabindex: 0 }
                                : {};

                            return (
                                <div
                                    class={`org-card fade-up ${modalClass}`}
                                    style={`transition-delay:${i * 75}ms`}
                                    {...cardRole}
                                    {...modalAttr}
                                >
                                    <div class="org-name">{org.name}</div>
                                    {(org.role || org.period || org.url) && (
                                        <div class="org-card-footer">
                                            {org.role && (
                                                <div class="org-role">
                                                    {org.role}
                                                </div>
                                            )}
                                            {org.period && (
                                                <div class="org-period">
                                                    {org.period}
                                                </div>
                                            )}
                                            {org.url && (
                                                <a
                                                    href={org.url}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="modal-btn org-url-btn"
                                                >
                                                    <Fragment
                                                        set:html={
                                                            ICONS.external
                                                        }
                                                    />{' '}
                                                    公式HP
                                                </a>
                                            )}
                                        </div>
                                    )}
                                </div>
                            );
                        })
                    }
                </div>
            </div>
        </section>

        {
            skills.length > 0 && (
                <section id="skills" class="section" aria-label="技能">
                    <div class="container">
                        <div class="section-header fade-up">
                            <h2 class="section-title">技能</h2>
                        </div>
                        <div class="skills-orbit fade-up">
                            <ul class="orbit-legend" aria-hidden="true">
                                {skillRings.map((ring) => (
                                    <li data-level={ring.level}>
                                        <span class="orbit-dot" />
                                        {ring.level}
                                    </li>
                                ))}
                            </ul>
                            <div class="orbit" id="orbit">
                                <div class="orbit-core" aria-hidden="true">
                                    <span class="orbit-core-level" id="orbit-level" />
                                    <span class="orbit-core-name" id="orbit-name">Skills</span>
                                </div>
                                {skillRings.map((ring, ri) => (
                                    <ol
                                        class="orbit-ring"
                                        style={`--ring:${ri}`}
                                        data-level={ring.level}
                                        aria-label={`${ring.level}の技能`}
                                    >
                                        {ring.items.map((s) => (
                                            <li
                                                class="orbit-item"
                                                style={`--a:${s.angle}deg`}
                                            >
                                                <button
                                                    type="button"
                                                    class="orbit-chip"
                                                    data-name={s.name}
                                                    data-level={ring.level}
                                                    data-desc={s.description ?? ''}
                                                >
                                                    {s.logoData ? (
                                                        <svg
                                                            class="orbit-icon orbit-logo"
                                                            viewBox={s.logoData.viewBox}
                                                            aria-hidden="true"
                                                            set:html={s.logoData.body}
                                                        />
                                                    ) : s.image ? (
                                                        <img
                                                            class="orbit-icon orbit-logo"
                                                            src={`/${s.image}`}
                                                            alt=""
                                                            width="22"
                                                            height="22"
                                                            loading="lazy"
                                                        />
                                                    ) : s.iconData ? (
                                                        <svg
                                                            class="orbit-icon"
                                                            viewBox="0 0 24 24"
                                                            aria-hidden="true"
                                                            style={`--ic:#${s.iconData.hex}`}
                                                        >
                                                            <path d={s.iconData.path} />
                                                        </svg>
                                                    ) : (
                                                        <span class="orbit-mono" aria-hidden="true">{s.mono}</span>
                                                    )}
                                                    <span class="orbit-name">{s.name}</span>
                                                    {s.description && (
                                                        <span class="orbit-desc">{s.description}</span>
                                                    )}
                                                </button>
                                            </li>
                                        ))}
                                    </ol>
                                ))}
                            </div>
                            <p class="orbit-caption" id="orbit-caption" aria-live="polite"></p>
                        </div>
                        {skillDomains.length > 0 && (
                            <div class="skills-domains fade-up">
                                <h3 class="skills-category-title">Domains</h3>
                                <dl class="domains-list">
                                    {skillDomains.map((d) => (
                                        <div class="domain-row">
                                            <dt>{d.name}</dt>
                                            <dd>{d.description}</dd>
                                        </div>
                                    ))}
                                </dl>
                            </div>
                        )}
                    </div>
                </section>
            )
        }

        <section id="works" class="section" aria-label="制作物">
            <div class="container">
                <div class="section-header fade-up">
                    <h2 class="section-title">制作物</h2>
                </div>
                <div
                    class="filter-bar"
                    id="filter-bar"
                    role="toolbar"
                    aria-label="タグフィルター"
                >
                    <button
                        id="filter-all"
                        class="filter-btn active"
                        data-tag="all"
                    >
                        すべて <span class="filter-count">{works.length}</span>
                    </button>
                    {
                        allTags.map((tag) => (
                            <button class="filter-btn" data-tag={tag}>
                                {tag}{' '}
                                <span class="filter-count">
                                    {tagCounts[tag]}
                                </span>
                            </button>
                        ))
                    }
                </div>
                <div class="works-grid" id="works-grid">
                    {
                        works.map((work, i) => {
                            const tagList = (work.tags ?? []).join(',');
                            const delay = Math.min(i * 80, 400);

                            return (
                                <article
                                    class="work-card fade-up"
                                    data-has-detail={
                                        worksDetail[i] ? '' : undefined
                                    }
                                    data-tags={tagList}
                                    style={`transition-delay:${delay}ms`}
                                    aria-label={work.title}
                                >
                                    {SHOW_THUMBNAILS && work.thumbnail ? (
                                        <div class="work-thumbnail">
                                            <img
                                                src={`/${work.thumbnail}`}
                                                alt={work.title}
                                                loading="lazy"
                                            />
                                        </div>
                                    ) : SHOW_THUMBNAILS ? (
                                        <div
                                            class="work-thumbnail-placeholder"
                                            aria-hidden="true"
                                        >
                                            ◈
                                        </div>
                                    ) : null}

                                    {worksDetail[i] && (
                                        <span
                                            class="work-detail-badge"
                                            aria-hidden="true">詳細</span
                                        >
                                    )}
                                    <div class="work-body">
                                        {work.date && (
                                            <time
                                                class="work-date"
                                                datetime={work.date}
                                            >
                                                {work.date}
                                            </time>
                                        )}
                                        <h3 class="work-title">
                                            {worksDetail[i] ? (
                                                <button
                                                    type="button"
                                                    class="work-detail-btn"
                                                    data-work-index={i}
                                                    aria-haspopup="dialog"
                                                >
                                                    {work.title}
                                                </button>
                                            ) : (
                                                work.title
                                            )}
                                        </h3>
                                        <p class="work-description">
                                            {work.description || ''}
                                        </p>
                                        <div
                                            class="work-tags"
                                            aria-label="タグ"
                                        >
                                            {(work.tags ?? []).map((tag) => (
                                                <span
                                                    class="tag"
                                                    data-color={getTagColor(
                                                        tag
                                                    )}
                                                >
                                                    {tag}
                                                </span>
                                            ))}
                                        </div>
                                        <div class="work-links">
                                            {work.detailUrl && (
                                                <a
                                                    href={work.detailUrl}
                                                    class="work-link work-link--detail"
                                                    aria-label={`${work.title}の詳細を見る`}
                                                >
                                                    <Fragment
                                                        set:html={
                                                            ICONS.external
                                                        }
                                                    />{' '}
                                                    詳しく見る
                                                </a>
                                            )}
                                            {work.url && (
                                                <a
                                                    href={work.url}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="work-link"
                                                    aria-label={`${work.title}を開く`}
                                                >
                                                    <Fragment
                                                        set:html={
                                                            ICONS.external
                                                        }
                                                    />{' '}
                                                    Webページ
                                                </a>
                                            )}
                                            {work.github && (
                                                <a
                                                    href={work.github}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="work-link"
                                                    aria-label={`${work.title}のコード`}
                                                >
                                                    <Fragment
                                                        set:html={ICONS.github}
                                                    />{' '}
                                                    GitHub
                                                </a>
                                            )}
                                        </div>
                                    </div>
                                </article>
                            );
                        })
                    }
                </div>
            </div>
        </section>

        {
            activities.length > 0 && (
                <section id="activities" class="section" aria-label="活動記録">
                    <div class="container">
                        <div class="section-header fade-up">
                            <h2 class="section-title">活動記録</h2>
                        </div>
                        <div class="activities-list">
                            {activities.map((act, i) => {
                                const isExternal =
                                    act.url &&
                                    (act.url.startsWith('http://') ||
                                        act.url.startsWith('https://') ||
                                        act.url.startsWith('//'));
                                const delay = Math.min(i * 75, 400);

                                return (
                                    <div
                                        class="activity-card fade-up"
                                        style={`transition-delay:${delay}ms`}
                                    >
                                        <div class="activity-header">
                                            {act.date && (
                                                <time
                                                    class="activity-date"
                                                    datetime={act.date}
                                                >
                                                    {act.date}
                                                </time>
                                            )}
                                            <h3 class="activity-title">
                                                {act.url ? (
                                                    <a
                                                        href={act.url}
                                                        target={
                                                            isExternal
                                                                ? '_blank'
                                                                : undefined
                                                        }
                                                        rel={
                                                            isExternal
                                                                ? 'noopener noreferrer'
                                                                : undefined
                                                        }
                                                        class="activity-link"
                                                    >
                                                        {act.title}
                                                        {isExternal && (
                                                            <span class="activity-icon">
                                                                <Fragment
                                                                    set:html={
                                                                        ICONS.external
                                                                    }
                                                                />
                                                            </span>
                                                        )}
                                                    </a>
                                                ) : (
                                                    act.title
                                                )}
                                            </h3>
                                        </div>
                                        {act.description && (
                                            <p class="activity-description">
                                                {act.description}
                                            </p>
                                        )}
                                    </div>
                                );
                            })}
                        </div>
                    </div>
                </section>
            )
        }
    </main>

    <footer class="footer">
        <div class="container footer-inner">
            <p id="footer-name" class="footer-copy">
                {`© ${new Date().getFullYear()} ${profile.name}`}
            </p>
            <div class="footer-links" id="footer-links">
                {
                    profile.github && (
                        <a
                            href={profile.github}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="footer-link"
                            aria-label="GitHub"
                        >
                            <Fragment set:html={ICONS.github} />
                        </a>
                    )
                }
                {
                    profile.x && (
                        <a
                            href={profile.x}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="footer-link"
                            aria-label="X"
                        >
                            <Fragment set:html={ICONS.x} />
                        </a>
                    )
                }
            </div>
        </div>
    </footer>

    <div id="org-modal" class="modal" aria-hidden="true">
        <div class="modal-overlay" id="modal-overlay"></div>
        <div
            class="modal-container"
            role="dialog"
            aria-modal="true"
            aria-labelledby="modal-title"
        >
            <header class="modal-header">
                <h2 class="modal-title" id="modal-title"></h2>
                <button class="modal-close" id="modal-close" aria-label="閉じる"
                    >&times;</button
                >
            </header>
            <div class="modal-content" id="modal-content"></div>
            <footer class="modal-footer" id="modal-footer"></footer>
        </div>
    </div>

    <script is:inline define:vars={{ organizations, worksDetail }}>
        window.organizationsData = organizations;
        window.worksDetailData = worksDetail;
    </script>
    <script>
        import {
            ACTIVE_THEME,
            applyTheme,
            escHtml,
            observeElements,
            ICONS,
        } from '../scripts/common.js';

        applyTheme(ACTIVE_THEME);

        // スクロールヒントの処理
        const setupScrollHintObserver = () => {
            const scrollHint = document.querySelector('.hero-scroll-hint');
            const organizationsSection =
                document.getElementById('organizations');
            if (!scrollHint || !organizationsSection) return;
            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            scrollHint.style.pointerEvents = 'none';
                            scrollHint.style.opacity = '0';
                        } else {
                            scrollHint.style.pointerEvents = 'auto';
                            scrollHint.style.opacity = '1';
                        }
                    });
                },
                { threshold: 0.1 }
            );
            observer.observe(organizationsSection);
        };
        const scrollHint = document.querySelector('.hero-scroll-hint');
        if (scrollHint) {
            scrollHint.addEventListener(
                'animationend',
                setupScrollHintObserver,
                { once: true }
            );
        } else {
            setTimeout(setupScrollHintObserver, 2500);
        }

        // フィルター処理
        const filterBar = document.getElementById('filter-bar');
        if (filterBar) {
            filterBar.addEventListener('click', (e) => {
                const btn = e.target.closest('.filter-btn');
                if (!btn) return;
                document
                    .querySelectorAll('.filter-btn')
                    .forEach((b) => b.classList.remove('active'));
                btn.classList.add('active');
                const selected = btn.dataset.tag;
                document.querySelectorAll('.work-card').forEach((card) => {
                    const cardTags = card.dataset.tags
                        ? card.dataset.tags.split(',')
                        : [];
                    const show =
                        selected === 'all' || cardTags.includes(selected);
                    card.classList.toggle('hidden', !show);
                });
                setTimeout(observeElements, 50);
            });
        }

        // モーダル処理
        const modal = document.getElementById('org-modal');
        let lastTrigger = null;
        const FOCUSABLE =
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';

        function openModal({ title, contentHtml, footerHtml, trigger }) {
            if (!modal) return;
            document.getElementById('modal-title').textContent = title;
            document.getElementById('modal-content').innerHTML = contentHtml;
            document.getElementById('modal-footer').innerHTML = footerHtml;
            lastTrigger = trigger ?? null;
            modal.classList.add('is-open');
            modal.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
            modal.querySelector('.modal-container').scrollTop = 0;
            document.getElementById('modal-close').focus();
        }

        function openOrgModal(org, trigger) {
            let contentHtml = '';
            if (org.projects && org.projects.length > 0) {
                contentHtml += `<div class="modal-project-list">`;
                org.projects.forEach((p) => {
                    contentHtml += `
                    <div class="modal-project">
                        <div class="modal-project-name">${escHtml(p.name)}</div>
                        ${p.role ? `<div class="modal-project-role">${escHtml(p.role)}</div>` : ''}
                    </div>`;
                });
                contentHtml += `</div>`;
            }
            let footerHtml = '';
            if (org.url) {
                footerHtml = `
                    <a href="${escHtml(org.url)}" target="_blank" rel="noopener noreferrer" class="modal-btn">
                        ${ICONS.external} 公式HP
                    </a>
                `;
            }
            openModal({ title: org.name, contentHtml, footerHtml, trigger });
        }

        function openWorkModal(work, trigger) {
            const images = (work.images || [])
                .map(
                    (src) =>
                        `<img class="modal-work-image" src="${escHtml(src)}" alt="" loading="lazy" />`
                )
                .join('');
            const tags = (work.tags || [])
                .map(
                    (t) =>
                        `<span class="tag" data-color="${escHtml(String(t.color))}">${escHtml(t.name)}</span>`
                )
                .join('');
            const contentHtml = `
                ${images ? `<div class="modal-work-images">${images}</div>` : ''}
                <p class="modal-work-text">${escHtml(work.text)}</p>
                ${tags ? `<div class="modal-work-tags">${tags}</div>` : ''}
            `;
            let footerHtml = '';
            if (work.url) {
                footerHtml += `<a href="${escHtml(work.url)}" target="_blank" rel="noopener noreferrer" class="modal-btn">${ICONS.external} Webページ</a>`;
            }
            if (work.github) {
                footerHtml += `<a href="${escHtml(work.github)}" target="_blank" rel="noopener noreferrer" class="modal-btn modal-btn--ghost">${ICONS.github} GitHub</a>`;
            }
            openModal({ title: work.title, contentHtml, footerHtml, trigger });
        }

        function closeOrgModal() {
            if (!modal || !modal.classList.contains('is-open')) return;
            modal.classList.remove('is-open');
            modal.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
            if (lastTrigger && document.contains(lastTrigger)) {
                lastTrigger.focus();
            }
            lastTrigger = null;
        }

        const modalClose = document.getElementById('modal-close');
        const modalOverlay = document.getElementById('modal-overlay');
        if (modalClose) modalClose.addEventListener('click', closeOrgModal);
        if (modalOverlay) modalOverlay.addEventListener('click', closeOrgModal);
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeOrgModal();
            if (e.key !== 'Tab' || !modal?.classList.contains('is-open'))
                return;
            const items = [...modal.querySelectorAll(FOCUSABLE)];
            if (!items.length) return;
            const first = items[0];
            const last = items[items.length - 1];
            if (e.shiftKey && document.activeElement === first) {
                e.preventDefault();
                last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
                e.preventDefault();
                first.focus();
            }
        });

        document.querySelectorAll('.work-detail-btn').forEach((btn) => {
            btn.addEventListener('click', () => {
                const work = window.worksDetailData[btn.dataset.workIndex];
                if (work) openWorkModal(work, btn);
            });
        });

        document.querySelectorAll('.org-card-modal').forEach((card) => {
            card.addEventListener('click', (e) => {
                if (e.target.closest('a')) return;
                e.preventDefault();
                const index = parseInt(card.dataset.orgIndex, 10);
                const orgData = window.organizationsData[index];
                openOrgModal(orgData, card);
            });
            card.addEventListener('keydown', (e) => {
                if (e.target.closest('a')) return;
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    const index = parseInt(card.dataset.orgIndex, 10);
                    const orgData = window.organizationsData[index];
                    openOrgModal(orgData, card);
                }
            });
        });

        // 技能の軌道図: 選択した項目を中央と下の説明欄に表示
        const orbit = document.getElementById('orbit');
        if (orbit) {
            const coreName = document.getElementById('orbit-name');
            const coreLevel = document.getElementById('orbit-level');
            const caption = document.getElementById('orbit-caption');
            const idle = {
                name: coreName.textContent,
                caption: caption.textContent,
            };
            const core = orbit.querySelector('.orbit-core');
            const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
            // 中央の文字は、いったん薄くしてから差し替えて戻す
            let current = null;
            let swapTimer = 0;
            const render = (state) => {
                coreName.textContent = state.name;
                coreLevel.textContent = state.level;
                if (state.level) coreLevel.dataset.level = state.level;
                else delete coreLevel.dataset.level;
                caption.textContent = state.caption;
            };
            const setState = (state) => {
                if (current === state.key) return;
                current = state.key;
                clearTimeout(swapTimer);
                if (calm.matches) {
                    render(state);
                    return;
                }
                core.classList.add('is-swapping');
                swapTimer = setTimeout(() => {
                    render(state);
                    core.classList.remove('is-swapping');
                }, 120);
            };
            const show = (chip) => {
                const { name, level, desc } = chip.dataset;
                setState({ key: name, name, level, caption: desc || '' });
            };
            const reset = () =>
                setState({
                    key: null,
                    name: idle.name,
                    level: '',
                    caption: idle.caption,
                });
            // 項目の間や拡大時の縁で mouseleave と mouseenter が連続しても
            // 表示が戻らないよう、リセットは少し遅らせる
            let resetTimer = 0;
            const scheduleReset = () => {
                clearTimeout(resetTimer);
                resetTimer = setTimeout(reset, 150);
            };
            const showNow = (chip) => {
                clearTimeout(resetTimer);
                show(chip);
            };
            orbit.querySelectorAll('.orbit-item').forEach((item) => {
                const chip = item.querySelector('.orbit-chip');
                // 拡大する chip ではなく、拡大しない li で出入りを判定する
                item.addEventListener('mouseenter', () => showNow(chip));
                item.addEventListener('mouseleave', scheduleReset);
                chip.addEventListener('focus', () => showNow(chip));
                chip.addEventListener('blur', scheduleReset);
                chip.addEventListener('click', () => showNow(chip));
            });

            // ホバー・フォーカス中は公転をなめらかに減速して止め、離れたら加速して再開する
            orbit.classList.add('is-eased');
            let hovering = false;
            let focused = false;
            let rate = 1;
            let frame = 0;
            let last = 0;
            const spins = () =>
                orbit
                    .getAnimations({ subtree: true })
                    .filter((a) => a.animationName === 'orbit-spin');
            const step = (now) => {
                const dt = Math.min((now - last) / 1000, 0.05);
                last = now;
                const target = hovering || focused ? 0 : 1;
                rate += (target - rate) * (1 - Math.exp(-dt / 0.2));
                if (Math.abs(target - rate) < 0.003) rate = target;
                spins().forEach((a) => (a.playbackRate = rate));
                frame = rate === target ? 0 : requestAnimationFrame(step);
            };
            const ease = () => {
                if (frame) return;
                last = performance.now();
                frame = requestAnimationFrame(step);
            };
            orbit.addEventListener('mouseenter', () => {
                hovering = true;
                ease();
            });
            orbit.addEventListener('mouseleave', () => {
                hovering = false;
                ease();
            });
            orbit.addEventListener('focusin', () => {
                focused = true;
                ease();
            });
            orbit.addEventListener('focusout', () => {
                focused = false;
                ease();
            });
        }

        setTimeout(observeElements, 120);
    </script>
</Layout>
