---
import Layout from '../layouts/Layout.astro';
import { getPortfolioData, ICONS } from '../utils/data.js';
import '../styles/qr.css';

const portfolioData = getPortfolioData();
const profile = portfolioData.profile || {};

const qrItems = [
	{
		id: 'x',
		label: 'X (Twitter)',
		name: 'X (@ln67v)',
		url: profile.x || 'https://x.com/ln67v',
		icon: ICONS.x,
	},
	{
		id: 'portfolio',
		label: 'Portfolio',
		name: `${profile.name || 'wash'} Portfolio`,
		url: 'https://v76nl.github.io',
		icon: ICONS.external,
	},
	{
		id: 'github',
		label: 'GitHub',
		name: 'GitHub (@v76nl)',
		url: profile.github || 'https://github.com/v76nl',
		icon: ICONS.github,
	},
];
---

<Layout title={`QR Code | ${profile.name || 'wash'}`}>
	<div class="qr-page-container">
		<!-- ヘッダー -->
		<header class="qr-header">
			<a href="/" class="back-link" aria-label="ポートフォリオに戻る">
				<svg viewBox="0 0 24 24" aria-hidden="true" style="width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;">
					<polyline points="15 18 9 12 15 6"></polyline>
				</svg>
				戻る
			</a>
		</header>

		<!-- タイトル -->
		<div class="qr-title-wrapper">
			<h1 class="qr-page-title">{profile.name || 'wash'} の QR Code</h1>
			<p class="qr-page-subtitle">カメラで読み取ってアクセスできます</p>
		</div>

		<!-- タブ切替 -->
		<div class="qr-tabs" role="tablist" aria-label="QRコード選択">
			{qrItems.map((item, index) => (
				<button
					class={`qr-tab-btn ${index === 0 ? 'active' : ''}`}
					data-target={item.id}
					role="tab"
					aria-selected={index === 0 ? 'true' : 'false'}
				>
					<Fragment set:html={item.icon} />
					<span>{item.label}</span>
				</button>
			))}
		</div>

		<!-- QRカード表示領域 -->
		<div class="qr-card-wrapper">
			{qrItems.map((item, index) => {
				const qrApiUrl = `https://api.qrserver.com/v1/create-qr-code/?size=300x300&margin=12&data=${encodeURIComponent(item.url)}`;
				return (
					<div
						class="qr-card"
						id={`qr-card-${item.id}`}
						style={index === 0 ? '' : 'display: none;'}
						data-url={item.url}
						data-title={item.name}
						data-qr={qrApiUrl}
					>
						<img
							src={qrApiUrl}
							alt={`${item.name} の QRコード`}
							class="qr-image"
							loading="eager"
						/>
						<div class="qr-card-info">
							<h2 class="qr-card-name">
								<Fragment set:html={item.icon} />
								{item.name}
							</h2>
							<p class="qr-card-url">{item.url}</p>
						</div>
						<div class="qr-tap-hint">
							<svg viewBox="0 0 24 24" style="width:14px;height:14px;fill:currentColor;"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 11.99 14 9.5 14z"/></svg>
							タップして拡大
						</div>
					</div>
				);
			})}
		</div>

		<!-- 下部アクション -->
		<div class="qr-actions">
			<button id="copy-btn" class="qr-action-btn" type="button">
				<svg viewBox="0 0 24 24"><path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></svg>
				URLをコピー
			</button>
			<a id="open-link" href={qrItems[0].url} target="_blank" rel="noopener noreferrer" class="qr-action-btn">
				<Fragment set:html={ICONS.external} />
				直接開く
			</a>
		</div>
	</div>

	<!-- 拡大表示用モーダル -->
	<div id="qr-modal" class="qr-modal" role="dialog" aria-modal="true" aria-label="QRコード拡大表示">
		<div class="qr-modal-content">
			<img id="modal-qr-img" src="" alt="拡大QRコード" class="qr-modal-image" />
			<div class="qr-modal-info">
				<h3 id="modal-title" class="qr-modal-title"></h3>
				<p id="modal-url" class="qr-modal-url"></p>
			</div>
		</div>
		<p class="qr-modal-close-hint">タップして閉じる</p>
	</div>

	<script>
		import { ACTIVE_THEME, applyTheme } from '../scripts/common.js';
		applyTheme(ACTIVE_THEME);

		const tabBtns = document.querySelectorAll('.qr-tab-btn');
		const qrCards = document.querySelectorAll('.qr-card');
		const openLink = document.getElementById('open-link') as HTMLAnchorElement;
		const copyBtn = document.getElementById('copy-btn');
		const modal = document.getElementById('qr-modal');
		const modalQrImg = document.getElementById('modal-qr-img') as HTMLImageElement;
		const modalTitle = document.getElementById('modal-title');
		const modalUrl = document.getElementById('modal-url');

		let activeUrl = (qrCards[0] as HTMLElement)?.dataset.url || '';

		tabBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const target = (btn as HTMLElement).dataset.target;

				tabBtns.forEach((b) => {
					b.classList.remove('active');
					b.setAttribute('aria-selected', 'false');
				});
				btn.classList.add('active');
				btn.setAttribute('aria-selected', 'true');

				qrCards.forEach((card) => {
					const el = card as HTMLElement;
					if (el.id === `qr-card-${target}`) {
						el.style.display = 'flex';
						activeUrl = el.dataset.url || '';
						if (openLink) openLink.setAttribute('href', activeUrl);
					} else {
						el.style.display = 'none';
					}
				});
			});
		});

		qrCards.forEach((card) => {
			card.addEventListener('click', () => {
				const el = card as HTMLElement;
				if (modalQrImg) modalQrImg.src = el.dataset.qr || '';
				if (modalTitle) modalTitle.textContent = el.dataset.title || '';
				if (modalUrl) modalUrl.textContent = el.dataset.url || '';
				modal?.classList.add('active');
			});
		});

		modal?.addEventListener('click', () => {
			modal.classList.remove('active');
		});

		copyBtn?.addEventListener('click', async () => {
			if (!activeUrl) return;
			try {
				await navigator.clipboard.writeText(activeUrl);
				const originalText = copyBtn.innerText;
				copyBtn.innerText = 'コピー完了！';
				setTimeout(() => {
					copyBtn.innerText = originalText;
				}, 1800);
			} catch (e) {
				console.error(e);
			}
		});
	</script>
</Layout>
